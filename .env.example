# Copy this file to backend/.env or TrustVault/.env and fill in real values.
# Never commit real secrets. Never put server-only secrets in VITE_ variables.

# --- App ---
# development | production
ENVIRONMENT=development
# Allowed browser origin for CORS (Vite default). Use your Vercel URL in production.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (required for migrations, seed, and any DB-backed API) ---
# Supabase: Project Settings > Database > URI
# Example: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The app starts WITHOUT this value so you can inspect the skeleton and hit GET /health.
# Alembic and GET /health/db WILL fail until DATABASE_URL is set.
DATABASE_URL=

# --- Supabase Storage (required later for upload/download; not used in Stage 2) ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Server-only service role key. NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name (create in Supabase Storage; keep it private)
SUPABASE_STORAGE_BUCKET=documents

# --- Auth sessions (required from Stage 3; unused in Stage 2) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Cookie lifetime in minutes
SESSION_TTL_MINUTES=480
# true when serving over HTTPS (Render/Vercel production)
COOKIE_SECURE=false
# Lax for same-site local dev; None is required for Vercel+Render cross-site cookies
COOKIE_SAMESITE=lax

# --- Uploads (used from Stage 4) ---
MAX_UPLOAD_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,docx,txt

# --- Demo seed (Stage 10). Do not commit the real password. ---
DEMO_PASSWORD=
